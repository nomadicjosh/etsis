## Application variables.
APP_NAME=CodefyPHP
APP_ENV=development
APP_KEY=changeme
APP_DEBUG=false
# Filled with the absolute project path by `composer setup-environment`.
APP_BASE_PATH=
APP_BASE_URL=http://localhost:8080/

AUTH_LOGIN_ROUTE=login

## Cookies: enable secure cookies when deploying with HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=''
COOKIE_PATH=/
COOKIE_SAMESITE=lax

## Mailer configuration
MAILER_DSN=smtp://localhost
MAILER_SMTP_DSN=smtp://localhost
MAILER_SENDMAIL_DSN=sendmail://default
MAILER_QMAIL_DSN="sendmail://default?command=/usr/sbin/qmail-inject"
MAILER_TRANSACTIONAL_DSN=postmark+api://KEY@default
MAILER_DEBUG=false
MAILER_EML_FILE=files/mail-debug.eml
MAILER_FROM_EMAIL=no-reply@example.com
MAILER_FROM_NAME="${APP_NAME}"

## Database setup.
DB_CONNECTION=sqlite
# Leave empty to use database/codefy.sqlite; set an explicit DSN for other connections.
DB_DSN=
DB_TABLE_PREFIX=
DB_PERSISTENT=false
DB_USER=
DB_PASSWORD=

## Redis Setup
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAX_RETRIES=5
REDIS_DB=5
REDIS_CACHE_DB=0

## Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

## Logger email setup.
LOGGER_EMAIL_SUBJECT="[System Error] Logger"
# LOGGER_FROM_EMAIL="${MAILER_FROM_EMAIL}"
# LOGGER_TO_EMAIL=alerts@example.com

## Firewall
# FIREWALL_SLACK_WEBHOOK=
# FIREWALL_ALERT_EMAIL="${LOGGER_TO_EMAIL}"

## Public and student portal
PORTAL_NAME=etsis
# campus-harbor, campus-quad, or campus-horizon
PORTAL_THEME=campus-harbor

## Optional Stripe-hosted student account checkout (disabled until configured)
PORTAL_PAYMENTS_ENABLED=false
PORTAL_PAYMENTS_LIVE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional course authoring assistance. Disabled until an institution explicitly configures it.
SIS_AI_ENABLED=false
SIS_AI_DATA_POLICY_APPROVED=false
SIS_AI_LABEL="Institutional AI service"
SIS_AI_ENDPOINT=https://api.openai.com/v1
SIS_AI_PROTOCOL=responses
SIS_AI_AUTH=bearer
SIS_AI_KEY=
SIS_AI_MODEL=
SIS_AI_ALLOW_HTTP=false

# Optional Moodle integration. External effects have separate opt-ins.
# Direct launch is separate from account provisioning. Use a dedicated 64-character lowercase hex secret.
SIS_MOODLE_LAUNCH_ENABLED=false
SIS_MOODLE_LAUNCH_SECRET=
SIS_MOODLE_ENABLED=false
SIS_MOODLE_ACCOUNT_REQUESTS_ENABLED=false
SIS_MOODLE_PROVISIONING_ENABLED=false
SIS_MOODLE_URL=
SIS_MOODLE_TOKEN=
SIS_MOODLE_CA_FILE=

# Optional section access synchronization (separate from account provisioning).
SIS_MOODLE_SECTION_SYNC_ENABLED=false
# Existing SIS service account with Moodle management, catalog, student-read and person-management grants.
SIS_MOODLE_SYNC_ACTOR=
SIS_MOODLE_ACCESS_BEFORE_DAYS=0
SIS_MOODLE_ACCESS_AFTER_DAYS=0
