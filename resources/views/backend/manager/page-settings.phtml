$query = ['route' => 'page_settings', 'action' => $page === null ? 'create' : 'edit'];
if ($page !== null) {
    $query['page'] = $page->getId();
}
$actionUrl = $managerUrl . '?' . http_build_query($query);
$designUrl = rtrim((string) config('vihzhuo.pagebuilder.url', '/admin/manager/pagebuilder'), '/')
