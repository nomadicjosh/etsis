$submitted = is_array($submitted) ? $submitted : [];
$value = static function (string $field, string $fallback = '') use ($submitted, $pageData): string {
    return is_string($submitted[$field] ?? null) ? $submitted[$field] : (string) ($pageData[$field] ?? $fallback);
};
$translation = static function (string $field, string $locale) use ($submitted, $translations): string {
    $input = is_array($submitted[$field] ?? null) ? $submitted[$field][$locale] ?? null : null;
    return is_string($input) ? $input : (string) ($translations[$locale][$field] ?? '');
};
$languages = $languageOptions ?? phpb_active_languages();
