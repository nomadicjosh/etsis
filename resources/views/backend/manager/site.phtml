                        <h2 class="h4"><?= trans_html('Website languages') ?></h2>
                        <label class="form-label" for="site-languages"><?= trans_html('Active languages') ?></label>
                        <p id="site-languages-help" class="form-text"><?= trans_html('Use Ctrl or Command to select multiple languages.') ?></p>
                        <select id="site-languages" name="languages[]" class="form-select" multiple required
                            aria-describedby="site-languages-help">
                            <?php foreach ($languageOptions as $locale => $languageName): ?>
                                <option value="<?= $esc($locale) ?>"
                                    <?= in_array($locale, $activeLanguages, true) ? 'selected' : '' ?>>
                                    <?= $esc($languageName) ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                        <button class="btn btn-primary mt-3" type="submit"><?= trans_html('Save website settings') ?></button>
                    </form>
                <?php endif; ?>
            </div>
        </main>
        <div class="offcanvas offcanvas-end site-review" tabindex="-1" id="site-review" aria-labelledby="site-review-title">
            <div class="offcanvas-header border-bottom">
                <h2 id="site-review-title" class="h4 mb-0"><?= trans_html(
                    "Review before publishing",
                ) ?></h2>
                <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="<?= trans_attr(
                    "Close review",
                ) ?>"></button>
            </div>
            <div class="offcanvas-body" id="site-review-body"></div>
        </div>
        <form id="site-csrf" hidden><?= $csrfMarkup ?? csrf_field() ?></form>
        <script id="site-labels" type="application/json"><?= json_encode(
            $labels,
            JSON_HEX_TAG |
                JSON_HEX_AMP |
                JSON_HEX_APOS |
                JSON_HEX_QUOT |
                JSON_THROW_ON_ERROR,
        ) ?></script>
        <script id="site-config" type="application/json"><?= json_encode(
            $settings,
            JSON_HEX_TAG |
                JSON_HEX_AMP |
                JSON_HEX_APOS |
                JSON_HEX_QUOT |
                JSON_THROW_ON_ERROR,
        ) ?></script>
        <script src="/assets/vendor/bootstrap.bundle.min.js"></script>
        <script src="/assets/vendor/sortable.min.js"></script>
        <script src="/assets/js/site-navigation.js"></script>
        <script src="/assets/js/site-manager.js"></script>
    </body>
</html>
