<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Academic transcript</title>
        <style>
            @page { margin: 0.6in; }
            body { color: #172b40; background: #fff; font: 11px/1.5 "DejaVu Sans", sans-serif; margin: 0; }
            main { max-width: 72rem; margin: 0 auto; }
            h1 { font-size: 22px; margin-bottom: 0; }
            h2 { font-size: 16px; }
            .issuer { border-bottom: 2px solid #235b93; padding-bottom: 12px; }
            .address { white-space: pre-wrap; }
            .scroll { overflow-x: auto; }
            .scroll:focus-visible { outline: 3px solid #235b93; outline-offset: 3px; }
            table { border-collapse: collapse; width: 100%; margin-top: 14px; }
            caption { text-align: left; font-weight: bold; padding: 8px 0; }
            thead { display: table-header-group; }
            th, td { text-align: left; border-bottom: 1px solid #aab5bf; padding: 5px; overflow-wrap: anywhere; }
            th { color: #172b40; background: #edf1f4; }
            tr { page-break-inside: avoid; }
            dl { margin: 12px 0; }
            dt { font-weight: bold; }
            dd { margin: 0 0 8px; overflow-wrap: anywhere; }
            footer { margin-top: 18px; font-size: 10px; overflow-wrap: anywhere; }
            @media screen and (max-width: 600px) { body { padding: 14px; font-size: 14px; } }
