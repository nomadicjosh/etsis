<?php

use function Codefy\Framework\Helpers\trans_html;

?>
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="Content-Security-Policy"
            content="default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Academic transcript</title>
        <style>
            @page { margin: 0.6in; size: <?= $layout->paper === "a4"
                ? "A4"
                : "letter" ?>; }
            body { color: #172b40; background: #fff; font: 11px/1.5 "DejaVu Sans", sans-serif; margin: 0; }
            main { max-width: 72rem; margin: 0 auto; }
            h1 { font-size: 22px; margin-bottom: 0; }
            h2 { font-size: 16px; }
            .issuer { border-bottom: 2px solid #235b93; padding-bottom: 12px; }
            .address { white-space: pre-wrap; }
            .scroll { overflow-x: auto; }
            .scroll:focus-visible { outline: 3px solid #235b93; outline-offset: 3px; }
            table { border-collapse: collapse; width: 100%; margin-top: 14px; }
            caption { text-align: left; font-weight: bold; padding: 8px 0; }
            thead { display: table-header-group; }
            th, td { text-align: left; border-bottom: 1px solid #aab5bf; padding: 5px; overflow-wrap: anywhere; }
            th { color: #172b40; background: #edf1f4; }
            tr { page-break-inside: avoid; }
            dl { margin: 12px 0; }
            dt { font-weight: bold; }
            dd { margin: 0 0 8px; overflow-wrap: anywhere; }
            footer { margin-top: 18px; font-size: 10px; overflow-wrap: anywhere; }
            .academic-standing { overflow-wrap: anywhere; word-wrap: break-word; }
            .transcript-classic .issuer { border-bottom: 3px double #526170; text-align: center; }
            .transcript-classic h1, .transcript-classic h2 { font-family: "DejaVu Serif", serif; }
            .transcript-classic h1 { font-size: 25px; }
            .transcript-modern .issuer { border-top: 5px solid #235b93; padding-top: 14px; }
            .transcript-modern h1 { color: #1c4d7b; }
            .transcript-modern h2 { color: #40566a; font-weight: normal; }
            .preview-note { border: 1px dashed #526170; padding: 10px; font-weight: bold; }
            @media screen and (max-width: 600px) { body { padding: 14px; font-size: 14px; } }
        </style>
    </head>
    <body class="<?= str_starts_with($layout->code, "modern-")
        ? "transcript-modern"
        : "transcript-classic" ?>">
        <main>
            <?php if ($document["preview"]): ?>
                <p class="preview-note">Preview only. This transcript has not been prepared or issued.</p>
            <?php endif; ?>
            <header class="issuer">
                <h1><?= $escape(
                    $document["issuer"]["name"] ?: "Institution not configured",
                ) ?></h1>
                <p class="address"><?= $escape(
                    $document["issuer"]["address"],
                ) ?></p>
                <h2><?= $document["preview"]
                    ? "Academic transcript preview — not issued"
                    : "Official academic transcript" ?></h2>
            </header>
            <dl>
                <dt>Student</dt>
                <dd><?= $escape($document["student"]["name"]) ?></dd>
                <dt>Institutional ID</dt>
                <dd><?= $escape(
                    $document["student"]["institutional_id"],
                ) ?></dd>
                <dt>Primary program at preparation</dt>
                <dd><?= $escape($document["program"]["code"]) ?> — <?= $escape(
                    $document["program"]["title"],
                ) ?></dd>
                <dt>Catalog year</dt>
                <dd><?= $escape(
                    $document["catalog"]["year_code"] ?? "Catalog needs review",
                ) ?></dd>
            </dl>
            <?php if (
                ($document["academic_verification"]["status"] ?? null) ===
                "history_gaps"
            ): ?>
                <p>Some earlier academic history was not recorded.
                    Current-state observations are identified; missing earlier decisions remain unknown.</p>
            <?php endif; ?>
            <?php if (
                !empty(
                    $document["identity_verification"][
                        "earlier_history_unknown"
                    ]
                )
            ): ?>
                <p>Earlier name and ID history was not fully recorded; this document preserves the reviewed profile.</p>
            <?php endif; ?>
            <?php if (
                ($document["program_verification"]["status"] ?? null) ===
                "closed"
            ): ?>
                <p>The primary program pursuit was closed at preparation.</p>
            <?php endif; ?>
            <?php if (isset($document['standing'])): ?>
                <section class="academic-standing" aria-labelledby="standing-title">
                    <h2 id="standing-title">Recorded academic standing</h2>
                    <p>
                        Standing under the primary program pursuit at preparation,
                        with recorded periods starting on or before
                        <?= $escape($document['standing']['through']) ?>.
                        Earlier unrecorded standing is not inferred.
                    </p>
                    <?php if (!empty($document['standing']['filtered'])): ?>
                        <p><?= trans_html('This document includes institution-selected standing definitions.') ?></p>
                    <?php endif; ?>
                    <?php if ($document['standing']['periods'] === []): ?>
                        <?php if (!empty($document['standing']['filtered'])): ?>
                            <p><?= trans_html('No selected academic standing is included through this date.') ?></p>
                        <?php else: ?>
                            <p>No standing is recorded through this date.</p>
                        <?php endif; ?>
                    <?php else: ?>
                        <ul>
                            <?php foreach ($document['standing']['periods'] as $period): ?>
                                <li>
                                    <strong><?= $escape($period['code']) ?> · <?= $escape($period['title']) ?></strong>
                                    — <?= $escape($period['starts_on']) ?> through
                                    <?= $escape($period['ends_on'] ?? 'No end recorded') ?>.
                                </li>
                            <?php endforeach; ?>
                        </ul>
                    <?php endif; ?>
                </section>
            <?php endif; ?>
            <div class="scroll" tabindex="0" role="region" aria-label="Academic credit history">
                <table>
                    <caption>Academic credit history; dropped enrollments are omitted</caption>
                    <thead>
                        <tr>
                            <th scope="col">Term</th>
                            <th scope="col">Course</th>
                            <th scope="col">Title</th>
                            <th scope="col">Type</th>
                            <th scope="col">Attempted</th>
                            <th scope="col">Earned</th>
                            <th scope="col">Grade</th>
                            <th scope="col">Academic dates</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($document["credits"] as $row): ?>
                            <tr>
                                <td><?= $escape($row["term_code"]) ?></td>
                                <td><?= $escape($row["course_code"]) ?></td>
                                <td><?= $escape($row["course_title"]) ?></td>
                                <td><?= $escape($row["credit_type"]) ?></td>
                                <td><?= $credits(
                                    $row["attempted_milli"],
                                ) ?></td>
                                <td><?= $credits(
                                    $row["completed_milli"],
                                ) ?></td>
                                <td><?= $escape(
                                    $row["grade_code"] ?? "In progress",
                                ) ?></td>
                                <td>
                                    <div>
                                        Source period:
                                        <?= $escape(
                                            $row["academic_on"] ??
                                                (!empty(
                                                    $row["section_version_id"]
                                                )
                                                    ? "Retained by offering"
                                                    : "Unknown"),
                                        ) ?>
                                    </div>
                                    <div>Completion: <?= $escape(
                                        $row["completed_on"] ?? "Not recorded",
                                    ) ?></div>
                                    <?php if (
                                        isset($row["history_recorded"]) &&
                                        !$row["history_recorded"]
                                    ): ?>
                                        <div>Observed current facts; earlier decisions unknown.</div>
                                    <?php elseif (
                                        !empty($row["earlier_history_unknown"])
                                    ): ?>
                                        <div>Some earlier decisions are unknown.</div>
                                    <?php endif; ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
            <dl>
                <dt>Total attempted credits</dt>
                <dd><?= $credits($document["totals"]["attempted_milli"]) ?></dd>
                <dt>Total earned credits</dt>
                <dd><?= $credits($document["totals"]["completed_milli"]) ?></dd>
                <dt>Cumulative GPA</dt>
                <dd><?= $document["totals"]["gpa_milli"] === null
                    ? "Not yet available"
                    : $credits($document["totals"]["gpa_milli"]) ?></dd>
            </dl>
            <p>Grades and credit values reflect the academic record at preparation.
                In-progress courses have no final grade.
                GPA includes only posted grades configured to count toward GPA;
                values are displayed to three decimal places.</p>
            <footer>
                <p>Document reference: <?= $escape(
                    $document["document_id"] ?? "Preview only",
                ) ?>.</p>
                <p>Prepared at: <?= $escape(
                    $document["issued_at"] ?? "Not issued",
                ) ?>. Recipient delivery is tracked separately; a download alone does not establish delivery.</p>
                <p>Document layout: <?= $escape($layout->label) ?>.</p>
            </footer>
        </main>
    </body>
</html>
