<section data-panel="imports" hidden aria-labelledby="imports-heading">
    <div class="page-heading">
        <div>
            <div class="eyebrow">A FRESH START, WITHOUT THE RE-TYPING</div>
            <h1 id="imports-heading">Bring your data along<span class="brand-dot">.</span></h1>
            <p>Match your columns, check the details, and import with confidence.</p>
        </div>
        <a id="import-sample" class="btn btn-outline-secondary" href="/assets/examples/courses.csv" download>
            <i class="bi bi-download" aria-hidden="true"></i> Sample CSV
        </a>
    </div>
    <ol class="import-steps" aria-label="Import progress">
        <li class="active" data-import-step="1" aria-current="step"><span>1</span> Choose a file</li>
        <li data-import-step="2"><span>2</span> Match your fields</li>
        <li data-import-step="3"><span>3</span> Review & import</li>
        <li data-import-step="4"><span>4</span> All set</li>
    </ol>
    <div class="surface import-surface">
        <div data-import-panel="1">
            <div class="upload-illustration" aria-hidden="true">
                <i class="bi bi-file-earmark-spreadsheet"></i><span>↑</span>
            </div>
            <h2>A little organization goes a long way.</h2>
            <p class="muted-text" id="import-description">Start with a course catalog CSV. UTF-8, up to 1 MB and 1,000 rows.</p>
            <div class="import-setup">
                <div>
                    <label class="form-label" for="import-target">Import destination</label>
                    <select id="import-target" class="form-select">
                        <option value="course">Courses</option>
                        <option value="program">Academic programs</option>
                        <optgroup label="Catalog reference lists">
                            <option value="subject">Subjects</option>
                            <option value="department">Departments</option>
                            <option value="academic_level">Academic levels</option>
                            <option value="course_level">Course levels</option>
                            <option value="award">Degrees &amp; awards</option>
                            <option value="instructional_method">Instructional methods</option>
                            <option value="campus">Campuses &amp; sites</option>
                            <option value="school">Schools &amp; colleges</option>
                            <option value="field_of_study">Fields of study</option>
                        </optgroup>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="import-source">Source name</label>
                    <input
                        class="form-control"
                        id="import-source"
                        maxlength="80"
                        value="course-catalog"
                        pattern="[A-Za-z0-9._-]{1,80}"
                        required
                    />
                    <div class="form-text">Use the same source name when repeating an import. Names use lowercase.</div>
                </div>
                <div>
                    <label class="form-label" for="import-delimiter">Columns separated by</label>
                    <select id="import-delimiter" class="form-select">
                        <option value=",">Comma (,)</option>
                        <option value=";">Semicolon (;)</option>
                        <option value="tab">Tab</option>
                    </select>
                </div>
                <div class="full-width">
                    <label class="form-label" for="import-file">Choose a CSV file</label>
                    <input class="form-control" type="file" id="import-file" accept=".csv,text/csv" />
                </div>
            </div>
            <button class="btn btn-primary mt-4" type="button" id="import-inspect">
                Match fields <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
        <div data-import-panel="2" hidden>
            <p class="eyebrow">CONNECT THE DOTS</p>
            <h2>Where should each column go?</h2>
            <p class="muted-text">Your source columns are on the right. You can leave unrelated source columns out.</p>
            <div id="import-file-summary"></div>
            <div id="import-mapping" class="mapping-list"></div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-outline-secondary" type="button" data-import-back="1">Back</button>
                <button class="btn btn-primary" type="button" id="import-review">
                    Review import <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div data-import-panel="3" hidden>
            <div class="review-heading">
                <span class="icon-soft"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow">ONE LAST LOOK</p>
                    <h2 id="import-review-title">Ready when you are.</h2>
                </div>
            </div>
            <div id="import-review-errors" role="alert"></div>
            <dl id="import-plan-summary" class="import-summary mt-3" aria-live="polite" aria-label="Import summary"></dl>
            <p class="muted-text mt-3" id="import-boundary">
                New courses are inactive drafts. Approve matching course links explicitly, or leave rows out.
                Existing courses and historical publications are preserved.
            </p>
            <div class="import-review-actions">
                <p id="import-choice-status" class="form-text" role="status"></p>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-secondary" type="button" data-import-back="2">Adjust mapping</button>
                    <button class="btn btn-outline-primary" type="button" id="import-refresh">Review choices</button>
                    <button class="btn btn-primary" type="button" id="import-commit">
                        <span id="import-commit-label">Import courses</span> <i class="bi bi-arrow-up-square" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <details id="import-catalog-setup" class="mb-4">
                <summary>Catalog setup</summary>
                <p class="form-text mt-2">Missing or retired classifications? Update the catalog here, close its drawer,
                    then select Review choices. Your file and row choices stay in place.</p>
                <div class="d-flex flex-wrap gap-2">
                    <button id="import-reference-subjects" class="btn btn-outline-secondary" type="button">
                        Set up subjects
                    </button>
                    <button id="import-reference-classes" class="btn btn-outline-secondary" type="button">
                        Set up departments &amp; levels
                    </button>
                    <button id="import-reference-program-fields" class="btn btn-outline-secondary" type="button" hidden>
                        Schools &amp; fields
                    </button>
                    <button id="import-reference-campus" class="btn btn-outline-secondary" type="button" hidden>
                        Campuses &amp; sites
                    </button>
                    <button id="import-reference-award" class="btn btn-outline-secondary" type="button" hidden>
                        Degrees &amp; awards
                    </button>
                </div>
            </details>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="import-plan-filter" class="form-label">Review rows</label>
                    <select id="import-plan-filter" class="form-select">
                        <option value="all">All rows</option>
                        <option value="unresolved">Needs attention</option>
                        <option value="create">New drafts</option>
                        <option value="link">Approved links</option>
                        <option value="skip">Previously imported</option>
                        <option value="omitted">Left out</option>
                        <option value="conflict">Conflicts</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="import-plan-search" class="form-label">Find an import row</label>
                    <input id="import-plan-search" class="form-control" type="search" maxlength="191" />
                </div>
            </div>
            <div
                id="import-plan-table"
                class="table-responsive"
                tabindex="0"
                role="region"
                aria-label="Import row review"
            ></div>
            <p id="import-plan-status" class="form-text" role="status"></p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button id="import-plan-previous" class="btn btn-outline-secondary" type="button">Previous rows</button>
                <button id="import-plan-next" class="btn btn-outline-secondary" type="button">Next rows</button>
            </div>
            <details class="mt-3">
                <summary>Original CSV sample</summary>
                <div
                    id="import-preview-table"
                    class="table-responsive mt-3"
                    tabindex="0"
                    role="region"
                    aria-label="Source CSV sample"
                ></div>
            </details>
        </div>
        <div data-import-panel="4" hidden>
            <span class="completion-mark" aria-hidden="true"><i class="bi bi-check2"></i></span>
            <p class="eyebrow">NICELY DONE</p>
            <h2>Your catalog is a little more complete.</h2>
            <p id="import-summary"></p>
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-outline-secondary" type="button" id="import-again">Import another file</button>
                <button id="import-reference-open" class="btn btn-primary" type="button" hidden>
                    Review references
                </button>
                <a
                    class="btn btn-primary"
                    id="import-draft-link"
                    href="/admin/workspace/courses/"
                    data-workspace="courses">
                    <span id="import-draft-label">Review course drafts</span> <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</section>
