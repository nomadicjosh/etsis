<?php

use Application\Http\Security\ApplicationContinuation;

use function Codefy\Framework\Helpers\trans;
use function Codefy\Framework\Helpers\trans_html;

$register = $mode === "register";
$logout = $mode === "logout";
$signInFailed = !$register && !$logout && ($signInFailed ?? false);
$authHeading = match (true) {
    $logout => trans_html('See you soon.'),
    $register => trans_html('Your next chapter starts with you.'),
    default => trans_html('Good to have you back.'),
};
$authLead = $logout
    ? trans_html('Ready to sign out of your campus account?')
    : trans_html('Your applications, academic life, and next steps. All in one welcoming place.');
$authFormHeading = match (true) {
    $logout => trans_html('Sign out securely'),
    $register => trans_html('Create your campus account'),
    default => trans_html('Sign in to your campus'),
};
$authSubmitLabel = match (true) {
    $logout => trans_html('Sign out'),
    $register => trans_html('Create account'),
    default => trans_html('Sign in'),
};
$applicationSelection ??= [];
$applicationLoginUrl = $loginUrl . ApplicationContinuation::query(['continue' => 'apply'] + $applicationSelection);
$applicationRegisterUrl = '/register/'
    . ($applicationSelection === [] ? '' : '?' . http_build_query($applicationSelection));
?>
<section class="campus-container campus-auth" aria-labelledby="campus-auth-title">
    <div class="campus-auth-intro">
        <p class="campus-eyebrow"><?=trans_html('A CAMPUS CONNECTED AROUND YOU');?></p>
        <h1 id="campus-auth-title"><?= $authHeading ?></h1>
        <p class="campus-lead"><?= $authLead ?></p>
        <img src="/themes/campus-harbor/public/images/campus.svg" alt="" width="640" height="480" />
    </div>
    <div class="campus-surface campus-auth-form">
        <?= $flashMarkup ?? \Codefy\Framework\Proxy\Codefy::$PHP->flash->display() ?>
        <h2><?= $authFormHeading ?></h2>
        <?php if (!$register && !$logout && ($maintenanceActive ?? false)): ?>
            <p class="alert alert-info" role="status">
                <?= trans_html(
                    'Maintenance is in progress. Only super administrators can sign in until the system reopens.'
                ); ?>
            </p>
        <?php endif; ?>
        <?php if ($signInFailed): ?>
            <p class="alert alert-danger" role="alert" id="campus-sign-in-error">
                <?=trans_html('We couldn’t sign you in. Check your email address and password, then try again.');?>
            </p>
        <?php endif; ?>
        <?php if ($register): ?>
            <p class="campus-muted">
                <?= trans_html(
                    'Already have a campus account? Sign in to keep your person record and applications together.'
                ); ?>
            </p>
        <?php endif; ?>
        <form method="post" action="<?= $this->esc($url) ?>">
            <?= $csrfMarkup ?? csrf_field() ?>
            <?php if ($continue): ?>
                <input type="hidden" name="continue" value="apply" />
                <?php foreach (($applicationSelection ?? []) as $field => $value): ?>
                    <input type="hidden" name="<?= $this->esc($field); ?>" value="<?= $this->esc($value); ?>" />
                <?php endforeach; ?>
            <?php endif; ?>
            <?php if (!$logout): ?>
                <div class="mb-4">
                    <label class="form-label" for="campus-email"><?=trans_html('Email address');?></label>
                    <input
                        class="form-control"
                        id="campus-email"
                        <?php if ($signInFailed): ?>
                            aria-invalid="true"
                            aria-describedby="campus-sign-in-error"
                            autofocus
                        <?php endif; ?>
                        type="email"
                        name="email"
                        autocomplete="<?= $register ? "email" : "username" ?>"
                        maxlength="191"
                        required
                    />
                </div>
                <?php if ($register): ?>
                    <div class="mb-4">
                        <label class="form-label" for="campus-username"><?=trans_html('Username');?></label>
                        <input
                            class="form-control"
                            id="campus-username"
                            name="username"
                            autocomplete="username"
                            minlength="<?= $this->esc($usernameLength) ?>"
                            maxlength="20"
                            pattern="[a-z_-]+"
                            aria-describedby="campus-username-help"
                            required
                        />
                        <p class="form-text" id="campus-username-help">
                            <?= $this->esc($usernameLength) ?>–20 lowercase letters, underscores, or hyphens.
                        </p>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-4">
                            <label class="form-label" for="campus-first-name"><?=trans_html('Given name');?></label>
                            <input
                                class="form-control"
                                id="campus-first-name"
                                name="first_name"
                                autocomplete="given-name"
                                minlength="1"
                                maxlength="191"
                                required
                            />
                        </div>
                        <div class="col-sm-6 mb-4">
                            <label class="form-label" for="campus-last-name"><?=trans_html('Family name');?></label>
                            <input
                                class="form-control"
                                id="campus-last-name"
                                name="last_name"
                                autocomplete="family-name"
                                minlength="1"
                                maxlength="191"
                                required
                            />
                        </div>
                    </div>
                <?php endif; ?>
                <div class="mb-4">
                    <label class="form-label" for="campus-password"><?=trans_html('Password');?></label>
                    <input
                        class="form-control"
                        id="campus-password"
                        <?php if ($signInFailed): ?>
                            aria-invalid="true"
                            aria-describedby="campus-sign-in-error"
                        <?php endif; ?>
                        name="password"
                        type="password"
                        autocomplete="<?= $register ? "new-password" : "current-password" ?>"
                        <?php if ($register): ?>
                            minlength="<?= $this->esc($passwordLength) ?>"
                            aria-describedby="campus-password-help"
                        <?php endif; ?>
                        required
                    />
                    <?php if ($register): ?>
                        <p class="form-text" id="campus-password-help">
                            <?= sprintf(
                                trans('Use at least %s characters. A memorable passphrase works well.'),
                                $this->esc($passwordLength),
                            ); ?>
                        </p>
                    <?php endif; ?>
                </div>
            <?php endif; ?>
            <button class="btn campus-button w-100" type="submit"><?= $authSubmitLabel ?></button>
        </form>
        <?php if ($logout || $register || !($maintenanceActive ?? false)): ?>
            <p class="campus-muted mt-4 mb-0">
                <?php if ($logout): ?>
                    <a href="/portal/student/"><?=trans_html('Return to my campus');?></a>
                <?php elseif ($register): ?>
                    <?=trans_html('Have an account?');?>
                    <a href="<?= $this->esc($applicationLoginUrl); ?>"><?=trans_html('Sign in to apply');?></a>
                <?php else: ?>
                    <?=trans_html('New here?');?>
                    <a href="<?= $this->esc($applicationRegisterUrl); ?>">
                        <?=trans_html('Create your campus account'); ?>
                    </a>
                <?php endif; ?>
            </p>
        <?php endif; ?>
    </div>
</section>
